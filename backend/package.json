{
  "name": "campusassist-backend",
  "version": "1.0.0",
  "description": "CampusAssist Smart Academic Management Platform - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node database/seed.js",
    "seed:mu": "node database/seed_mu_data.js",
    "db:init": "psql -U postgres -f database/schema.sql",
    "db:add": "psql -U postgres -d campusassist -f database/schema_additions.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "pdf-parse": "^1.1.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "moment": "^2.29.4",
    "pg-format": "^1.0.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
