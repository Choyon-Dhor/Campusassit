PORT=5000
NODE_ENV=development

# Database Configuration (either DATABASE_URL or individual params)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/campusassist
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=campusassist

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Password Reset
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
RETURN_PASSWORD_RESET_TOKEN=false
