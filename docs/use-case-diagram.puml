@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

title CampusAssist Use Case Diagram

actor Guest
actor Student
actor Teacher
actor Admin

rectangle "CampusAssist System" {

  usecase "View Landing Page" as UC_Landing
  usecase "Register" as UC_Register
  usecase "Login" as UC_Login
  usecase "Authenticate User" as UC_Auth

  usecase "View Dashboard" as UC_Dashboard
  usecase "Manage Profile" as UC_Profile
  usecase "View Notifications" as UC_Notifications

  usecase "View Announcements" as UC_ViewAnnouncements
  usecase "Manage Announcements" as UC_ManageAnnouncements

  usecase "View Routine" as UC_Routine
  usecase "View Results" as UC_Results
  usecase "View Free Classrooms" as UC_FreeRooms
  usecase "Access Smart Classrooms" as UC_AccessSmartClass
  usecase "Manage Smart Classroom" as UC_ManageSmartClass

  usecase "Access Resources" as UC_Resources
  usecase "Upload Resources" as UC_UploadResources
  usecase "Download Resources" as UC_DownloadResources
  usecase "Rate Resources" as UC_RateResources

  usecase "Join/Leave Study Groups" as UC_JoinGroups
  usecase "Participate in Study Groups" as UC_StudyGroups
  usecase "Send Group Messages" as UC_GroupMessages
  usecase "React/Comment in Groups" as UC_GroupReact

  usecase "Manage Personal Deadlines" as UC_Deadlines
  usecase "Book Consultations" as UC_BookConsult
  usecase "Create Consultation Hours" as UC_CreateConsult
  usecase "View Bus Schedule" as UC_Bus
  usecase "Submit Assignments" as UC_SubmitAssignment
  usecase "Manage Assignments" as UC_ManageAssignments
  usecase "Review/Grade Submissions" as UC_GradeSubmissions

  usecase "Manage Results" as UC_ManageResults
  usecase "Upload / Import / Publish Results" as UC_PublishResults

  usecase "Manage Users" as UC_ManageUsers
  usecase "Activate/Deactivate Users" as UC_ToggleUsers
  usecase "Upload Routine CSV" as UC_UploadRoutine
  usecase "Upload Bus Schedule" as UC_UploadBus
  usecase "Oversee Operations" as UC_Operations

  usecase "Create Smart Classroom" as UC_CreateClassroom
  usecase "Upload Students to Classroom" as UC_UploadStudents
  usecase "Mark Attendance" as UC_Attendance
  usecase "Add Marks" as UC_AddMarks
  usecase "Post Classroom Announcements/Resources" as UC_ClassroomPosts
}

